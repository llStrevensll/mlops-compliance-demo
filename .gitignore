# ============================================================
#  .gitignore  —  qué archivos NO se suben a GitHub
#  Regla de oro: nunca subir secretos, credenciales ni datos.
#  NOTA: git solo reconoce comentarios cuando '#' va al INICIO
#  de la línea. Por eso cada comentario va en su propia línea.
# ============================================================

# --- Python: archivos generados automáticamente ---
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# --- Entornos virtuales (los recrea uv, no se versionan) ---
.venv

# --- SECRETOS Y CREDENCIALES (NUNCA subir) ---
.env
.env.*
*.pem
*.key
credentials*
.aws/

# --- Artefactos de MLflow (modelos/experimentos locales) ---
mlruns/
mlartifacts/
*.db

# --- Modelos entrenados (pesados, no van a git) ---
*.pkl
*.joblib
*.bin
models/

# --- Métricas generadas por el entrenamiento (artefacto del CI) ---
metrics.json

# --- Datos (no subimos datasets) ---
data/*.csv
data/*.parquet
# Excepción: sí conservamos la carpeta vacía con su .gitkeep
!data/.gitkeep

# --- Sistema operativo / editor ---
.DS_Store
.idea/
.vscode/
